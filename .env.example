# === Apple Pass Identity ===
PASS_TYPE_ID=pass.com.yourname.fancard
TEAM_ID=YOUR_TEAM_ID

# === Signing Certs ===
# Option A: file paths (local dev)
SIGNER_CERT=certs/signerCert.pem
SIGNER_KEY=certs/signerKey.pem
SIGNER_PASSPHRASE=
WWDR_CERT=certs/wwdr.pem

# Option B: base64-encoded (Railway / Docker) — takes priority over file paths
# SIGNER_CERT_B64=
# SIGNER_KEY_B64=
# WWDR_CERT_B64=
# APNS_KEY_B64=

# === APNs Push (token-based) ===
APNS_KEY_PATH=certs/APNsAuthKey.p8
APNS_KEY_ID=YOUR_KEY_ID
APNS_HOST=https://api.push.apple.com

# === Server ===
PORT=3000
WEB_SERVICE_URL=https://your-app.up.railway.app

# === Fan Page ===
ARTIST_NAME=Your Artist Name

# === Admin ===
# Required for /admin, POST /broadcast, POST /api/posts. If unset, those are disabled.
ADMIN_PASSWORD=

# === Media uploads (Cloudinary) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Josh's Blog ===
# Admin usernames (comma-separated). Default: josh
ADMIN_USERNAMES=josh
# Free GIPHY key turns on GIF search in comments/chats (optional)
GIPHY_API_KEY=
# YouTube tab: channel whose uploads are listed (defaults to Josh's channel)
# YOUTUBE_CHANNEL_ID=
# Optional AI moderation on top of the free rules
OPENAI_API_KEY=
